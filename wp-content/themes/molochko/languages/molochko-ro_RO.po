# Contact page
msgid "Контакти"
msgstr "Contacte"

msgid "Зв'яжіться з нами"
msgstr "Contactați-ne"

msgid "Маєте питання або потрібна консультація? Напишіть нам або зателефонуйте — ми відповімо якомога швидше."
msgstr "Aveți întrebări sau aveți nevoie de consultanță? Scrieți-ne sau sunați — vă răspundem cât mai curând."

msgid "Контактна інформація"
msgstr "Informații de contact"

msgid "Телефон"
msgstr "Telefon"

msgid "Email"
msgstr "Email"

msgid "Адреса"
msgstr "Adresă"

msgid "Графік роботи"
msgstr "Program"

msgid "Напишіть нам"
msgstr "Scrieți-ne"

