msgstr "Toate"

# Practice areas
msgid "Усі напрямки практики"
msgstr "Toate domeniile de practică"

msgid "Навігація по напрямках"
msgstr "Navigare domenii"

msgid "Попередній напрямок"
msgstr "Domeniu anterior"

msgid "Наступний напрямок"
msgstr "Domeniu următor"

msgid "Потрібна консультація з цього напрямку?"
msgstr "Aveți nevoie de consultanță în acest domeniu?"

msgid "Отримайте кваліфіковану допомогу адвоката. Зв'яжіться з нами зручним способом."
msgstr "Obțineți ajutor calificat de avocat. Contactați-ne în mod convenabil."

# Blog
msgid "Блог"
msgstr "Blog"

msgid "Про право та практику"
msgstr "Despre drept și practică"

msgid "Корисні статті про законодавство, ваші права та типові юридичні ситуації."
msgstr "Articole utile despre legislație, drepturile dvs. și situații juridice tipice."

msgid "Навігація по сторінках"
msgstr "Navigare pagini"

msgid "Статей поки немає."
msgstr "Nu există încă articole."

msgid "Корисні статті"
msgstr "Articole utile"

msgid "Останні публікації"
msgstr "Ultimele publicații"

msgid "Про право, ваші права та типові юридичні ситуації — коротко та зрозуміло."
msgstr "Despre drept, drepturile dvs. și situații juridice tipice — pe scurt și clar."

msgid "Усі статті"
msgstr "Toate articolele"

msgid "Читати далі"
msgstr "Citește mai mult"

# Fancy boxes (front page default)
msgid "Безкоштовна консультація"
msgstr "Consultație gratuită"

msgid "Якщо вам потрібна допомога юриста, ми надамо безкоштовну консультацію незалежно від складності справи. Досвід, прозорість, результат."
msgstr "Dacă aveți nevoie de ajutor juridic, vă oferim o consultație gratuită indiferent de complexitatea cauzei. Experiență, transparență, rezultat."

msgid "Зв'язатися"
msgstr "Contactați-ne"

msgid "20 років досвіду"
msgstr "20 de ani experiență"

msgid "Найкращі юристи з багаторічним досвідом. Поєднуємо експертизу з індивідуальним підходом до кожної справи. Гарантуємо якість та результат."
msgstr "Cei mai buni avocați cu experiență de ani. Combinăm expertiza cu o abordare individuală pentru fiecare cauză. Garanție de calitate și rezultat."

msgid "Нагороди та сертифікати"
msgstr "Premii și certificate"

msgid "Ми отримали визнання та довіру клієнтів. Прозорість, чесність та ефективність — наші принципи роботи в кожній справі."
msgstr "Am câștigat recunoașterea și încrederea clienților. Transparență, onestitate și eficiență — principiile noastre în fiecare cauză."

# About / CTA
msgid "або"
msgstr "sau"

msgid "Записатися на консультацію"
msgstr "Programează-te la consultanță"

# Form / missing
msgid "Створіть форму в Контакт → Контактні форми (Contact Form 7)."
msgstr "Creați un formular în Contact → Formulare de contact (Contact Form 7)."

msgid "Створіть форму в Контакт → Контактні форми (Contact Form 7) і переконайтесь, що хоча б одна форма опублікована."
msgstr "Creați un formular în Contact → Formulare de contact (Contact Form 7) și asigurați-vă că cel puțin un formular este publicat."

msgid "Або натисніть кнопку «Замовити консультацію» у шапці сайту — відкриється форма для швидкого запиту."
msgstr "Sau apăsați butonul «Comandă consultanță» în antetul site-ului — se va deschide un formular pentru solicitare rapidă."
