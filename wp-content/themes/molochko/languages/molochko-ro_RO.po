msgstr "Toate cazurile"

msgid "Навігація по кейсах"
msgstr "Navigare cazuri"

msgid "Попередній кейс"
msgstr "Caz anterior"

msgid "Наступний кейс"
msgstr "Caz următor"

msgid "Потрібна консультація з вашого питання?"
msgstr "Aveți nevoie de consultanță pentru problema dvs.?"

msgid "Отримайте кваліфіковану допомогу адвоката."
msgstr "Obțineți ajutor calificat de avocat."

msgid "Фільтр за категоріями"
msgstr "Filtru pe categorii"

